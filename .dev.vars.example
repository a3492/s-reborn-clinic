# Cloudflare Pages 로컬 Functions (`wrangler pages dev`)용 예시
# 이 파일을 복사해 `.dev.vars`로 저장한 뒤 값을 채우세요.
#
# IMPORTANT — production source separation
# - Astro browser bundle의 PUBLIC_*: 현재 production에서는 GitHub Actions가 `npm run build`를
#   수행하므로 GitHub Actions repository/environment secrets가 canonical build source입니다.
# - Pages Functions server secrets: Cloudflare Pages runtime environment/bindings가 canonical source입니다.
# - 이 `.dev.vars` 파일은 로컬 Functions/runtime 테스트용이며 production GitHub build 값을 대체하지 않습니다.

# 로컬 Astro/클라이언트 테스트용 공개 값(선택)
PUBLIC_CF_ANALYTICS_TOKEN=
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Pages Functions server runtime
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 댓글 API에서 OAuth 사용자 식별(선택). 없으면 anon 댓글만.
SUPABASE_ANON_KEY=

# Turnstile
# 공개 site key는 browser widget용. Production build에서는 GitHub Actions secret에 동일 값을 설정.
PUBLIC_TURNSTILE_SITE_KEY=
# 비밀 key는 Pages Functions runtime 전용.
TURNSTILE_SECRET_KEY=
# runtime secret이 있는데 PUBLIC site key가 없는 조합은 금지:
# widget/token은 생성되지 않지만 server verification은 token을 요구해 403이 날 수 있습니다.

RESEND_API_KEY=
FROM_EMAIL=noreply@s-reborn.com

# 글 오류 신고 접수 시 관리자 알림 수신(선택, 쉼표 구분). 비우면 FROM_EMAIL로 시도.
ADMIN_EMAIL=

# 발행 후 구독자 일괄 알림 (`/api/notify-subscribers`) — 임의의 긴 문자열
NOTIFY_SUBSCRIBERS_SECRET=

# R2 미디어 업로드 (Pages Function 전용 — 브라우저/저장소에 노출 금지)
# npx wrangler r2 bucket create s-reborn-media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=s-reborn-media
R2_PUBLIC_URL=https://media.s-reborn-blog.pages.dev
# R2_REGION=auto

# Astro 클라이언트: R2_PUBLIC_URL 과 동일 권장 (히어로·미디어 UI에서 WebP 쿼리 자동)
# Production browser bundle에 사용하려면 GitHub Actions build-time PUBLIC_R2_MEDIA_URL에도 설정.
PUBLIC_R2_MEDIA_URL=

# 프로덕션 공개 사이트 원점 URL (알림 메일 링크용, 선택)
PUBLIC_SITE_URL=https://s-reborn-clinic.pages.dev

# 예약 발행(Edge Function → /api/admin/publish) 시 X-Publish-Secret 검증용. Supabase 함수 PUBLISH_SECRET 과 동일 값 권장.
PUBLISH_SECRET=
