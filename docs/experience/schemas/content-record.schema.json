{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-reborn.example/schemas/content-record.schema.json",
  "title": "S-Reborn Experience ContentRecord v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "slug",
    "title",
    "description",
    "status",
    "language",
    "updated_at",
    "editorial_pillar",
    "reader_intents",
    "medical_domains",
    "reader_situations",
    "core_thesis",
    "content_role",
    "medical_review_status"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "review", "scheduled", "published", "archived"] },
    "language": { "type": "string", "minLength": 2 },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "editorial_pillar": { "type": "string", "minLength": 1 },
    "reader_intents": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "medical_domains": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "reader_situations": { "type": "array", "items": { "type": "string" } },
    "core_thesis": { "type": "string", "minLength": 1 },
    "search_summary": { "type": ["string", "null"] },
    "content_role": { "enum": ["question", "case", "principle", "decision", "viewpoint", "guide", "other"] },
    "evidence_state": { "type": ["string", "null"] },
    "search_terms": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "procedure_names": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "questions_answered": { "type": "array", "items": { "type": "string" } },
    "questions_adjacent": { "type": "array", "items": { "type": "string" } },
    "hero_asset_id": { "type": ["string", "null"] },
    "hero_alt": { "type": ["string", "null"] },
    "card_summary": { "type": ["string", "null"] },
    "author_id": { "type": ["string", "null"] },
    "medical_review_status": { "type": "string", "minLength": 1 },
    "medical_reviewed_at": { "type": ["string", "null"], "format": "date-time" },
    "source_provenance": { "type": ["string", "null"] },
    "claim_limitations": { "type": "array", "items": { "type": "string" } }
  }
}
