---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { isAcademyBlogPost, postPermalink } from '../lib/academy';

interface Props {
  placement: 'before' | 'after';
  currentSlug: string;
  lead?: string;
  updated?: Date;
  case_disclosure?: string;
  primary_next?: string;
  related?: string[];
  references?: Array<{
    label: string;
    url: string;
    source_type?: string;
    note?: string;
  }>;
}

const {
  placement,
  currentSlug,
  lead,
  updated,
  case_disclosure,
  primary_next: primaryNextRef,
  related = [],
  references = [],
} = Astro.props;

const locale = Astro.currentLocale === 'en' ? 'en' : 'ko';
const isEnglish = locale === 'en';

const needsPostLookup = placement === 'after' && Boolean(primaryNextRef || related.length > 0);
const publicPosts = needsPostLookup
  ? (await getCollection('blog', ({ data }) => !data.draft)).filter((post) => !isAcademyBlogPost(post))
  : [];

function refTail(value: string) {
  return value.split('/').filter(Boolean).at(-1) ?? value;
}

function resolvePost(ref?: string): CollectionEntry<'blog'> | null {
  const value = (ref ?? '').trim();
  if (!value) return null;
  const tail = refTail(value);
  return (
    publicPosts.find((post) => post.id === value) ??
    publicPosts.find((post) => post.id.endsWith(`/${value}`)) ??
    publicPosts.find((post) => refTail(post.id) === tail) ??
    null
  );
}

const resolvedPrimaryNextPost = resolvePost(primaryNextRef);
const primaryNextPost = resolvedPrimaryNextPost?.id === currentSlug ? null : resolvedPrimaryNextPost;
const seen = new Set<string>([currentSlug]);
if (primaryNextPost) seen.add(primaryNextPost.id);
const curatedRelatedPosts = related
  .map((ref) => resolvePost(ref))
  .filter((post): post is CollectionEntry<'blog'> => Boolean(post))
  .filter((post) => {
    if (seen.has(post.id)) return false;
    seen.add(post.id);
    return true;
  })
  .slice(0, 2);

const hasCuratedReading = Boolean(primaryNextPost || curatedRelatedPosts.length > 0);
const hasBeforeBlocks = Boolean(lead || updated || case_disclosure);
const hasAfterBlocks = Boolean(references.length > 0 || hasCuratedReading);
---

{placement === 'before' && hasBeforeBlocks && (
  <>
    {lead && (
      <p class="journal-article-lead" data-journal-article-lead>{lead}</p>
    )}

    {updated && (
      <span
        class="journal-article-updated"
        data-journal-article-updated
        data-updated-iso={updated.toISOString()}
      >
        {isEnglish ? 'Reviewed' : '최종 검토'} {new Intl.DateTimeFormat(isEnglish ? 'en-US' : 'ko-KR', {
          year: 'numeric',
          month: isEnglish ? 'short' : 'long',
          day: 'numeric',
        }).format(updated)}
      </span>
    )}

    {case_disclosure && (
      <aside class="journal-case-disclosure" role="note" aria-label={isEnglish ? 'Case note' : '사례 고지'}>
        <strong>{isEnglish ? 'About this case' : '이 사례에 대하여'}</strong>
        <p>{case_disclosure}</p>
      </aside>
    )}

    <script is:inline>
      (() => {
        const lead = document.querySelector('[data-journal-article-lead]');
        const h1 = document.querySelector('.blog-post-title h1');
        if (lead && h1) h1.insertAdjacentElement('afterend', lead);

        const updated = document.querySelector('[data-journal-article-updated]');
        const submeta = document.querySelector('.blog-post-submeta');
        if (updated && submeta) {
          const sep = document.createElement('span');
          sep.className = 'blog-post-submeta-sep';
          sep.setAttribute('aria-hidden', 'true');
          sep.textContent = ' · ';
          submeta.append(sep, updated);
        } else if (updated && h1) {
          h1.insertAdjacentElement('afterend', updated);
        }
      })();
    </script>
  </>
)}

{placement === 'after' && hasAfterBlocks && (
  <>
    {references.length > 0 && (
      <section class="journal-references" aria-labelledby="journal-references-heading">
        <div class="journal-section-kicker">{isEnglish ? 'Evidence & references' : '근거와 더 읽을거리'}</div>
        <h2 id="journal-references-heading">{isEnglish ? 'References' : '참고자료'}</h2>
        <ol class="journal-reference-list">
          {references.map((reference) => (
            <li>
              <a href={reference.url} target="_blank" rel="noopener noreferrer external">
                {reference.label}
              </a>
              {reference.source_type && <span class="journal-reference-type">{reference.source_type}</span>}
              {reference.note && <p>{reference.note}</p>}
            </li>
          ))}
        </ol>
      </section>
    )}

    {hasCuratedReading && (
      <nav class="journal-curated-reading" aria-labelledby="journal-curated-reading-heading" data-journal-curated-reading>
        <div class="journal-section-kicker">{isEnglish ? 'Keep reading' : '이어서 읽기'}</div>
        <h2 id="journal-curated-reading-heading">{isEnglish ? 'Continue the idea' : '다음 생각으로 이어가세요'}</h2>

        {primaryNextPost && (
          <a class="journal-primary-next" href={postPermalink(primaryNextPost)}>
            <span class="journal-primary-next-label">{isEnglish ? 'Read next' : '다음으로 읽을 글'}</span>
            {primaryNextPost.data.series && (
              <span class="journal-card-series">{primaryNextPost.data.series}</span>
            )}
            <strong>{primaryNextPost.data.title}</strong>
            {primaryNextPost.data.description && <p>{primaryNextPost.data.description}</p>}
            <span class="journal-card-arrow" aria-hidden="true">→</span>
          </a>
        )}

        {curatedRelatedPosts.length > 0 && (
          <div class="journal-related-reading">
            <h3>{isEnglish ? 'Also worth reading' : '같이 읽으면 좋은 글'}</h3>
            <div class="journal-related-reading-grid">
              {curatedRelatedPosts.map((post) => (
                <a class="journal-related-card" href={postPermalink(post)}>
                  {post.data.series && <span class="journal-card-series">{post.data.series}</span>}
                  <strong>{post.data.title}</strong>
                  {post.data.description && <p>{post.data.description}</p>}
                </a>
              ))}
            </div>
          </div>
        )}
      </nav>
    )}

    {hasCuratedReading && (
      <script is:inline>
        (() => {
          const hideAutomaticRelated = () => {
            const curated = document.querySelector('[data-journal-curated-reading]');
            if (!curated) return;
            const automatic = document.querySelector('.blog-post-related');
            if (automatic) {
              automatic.setAttribute('hidden', '');
              automatic.setAttribute('aria-hidden', 'true');
            }
          };

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', hideAutomaticRelated, { once: true });
          } else {
            hideAutomaticRelated();
          }
        })();
      </script>
    )}
  </>
)}

<style>
  .journal-article-lead {
    margin: 0.7rem 0 0.35rem;
    max-width: 44rem;
    color: var(--t2);
    font-size: clamp(1.02rem, 1.8vw, 1.18rem);
    line-height: 1.75;
    font-weight: 500;
  }

  .journal-article-updated {
    color: var(--t3);
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .journal-case-disclosure {
    margin: 1.5rem 0 1.75rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--bg2);
    color: var(--t2);
  }

  .journal-case-disclosure strong {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--text);
    font-size: 0.88rem;
  }

  .journal-case-disclosure p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .journal-references,
  .journal-curated-reading {
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .journal-section-kicker {
    margin-bottom: 0.35rem;
    color: var(--accent-dark);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .journal-references h2,
  .journal-curated-reading h2 {
    margin: 0 0 1rem;
    color: var(--text);
    font-size: 1.2rem;
  }

  .journal-reference-list {
    margin: 0;
    padding-left: 1.25rem;
  }

  .journal-reference-list li {
    margin: 0.7rem 0;
    color: var(--t2);
    line-height: 1.55;
  }

  .journal-reference-list a {
    color: var(--text);
    font-weight: 700;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .journal-reference-type {
    margin-left: 0.45rem;
    color: var(--t3);
    font-size: 0.74rem;
  }

  .journal-reference-list p {
    margin: 0.25rem 0 0;
    color: var(--t3);
    font-size: 0.84rem;
  }

  .journal-primary-next,
  .journal-related-card {
    color: inherit;
    text-decoration: none;
  }

  .journal-primary-next {
    position: relative;
    display: block;
    padding: 1.35rem 3.5rem 1.35rem 1.35rem;
    border: 1px solid var(--rule);
    border-radius: 18px;
    background: var(--surface);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .journal-primary-next:hover,
  .journal-related-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 10px 24px rgba(28, 24, 20, 0.06);
  }

  .journal-primary-next-label {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--accent-dark);
    font-size: 0.76rem;
    font-weight: 800;
  }

  .journal-card-series {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--t3);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .journal-primary-next strong {
    display: block;
    color: var(--text);
    font-size: 1.08rem;
    line-height: 1.45;
  }

  .journal-primary-next p,
  .journal-related-card p {
    margin: 0.45rem 0 0;
    color: var(--t2);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .journal-card-arrow {
    position: absolute;
    right: 1.35rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent-dark);
    font-size: 1.35rem;
  }

  .journal-related-reading {
    margin-top: 1.35rem;
  }

  .journal-related-reading h3 {
    margin: 0 0 0.75rem;
    color: var(--text);
    font-size: 0.95rem;
  }

  .journal-related-reading-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .journal-related-card {
    display: block;
    padding: 1rem;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--surface);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .journal-related-card strong {
    display: block;
    color: var(--text);
    font-size: 0.94rem;
    line-height: 1.45;
  }

  @media (max-width: 640px) {
    .journal-related-reading-grid {
      grid-template-columns: 1fr;
    }

    .journal-primary-next {
      padding-right: 2.75rem;
    }
  }
</style>
