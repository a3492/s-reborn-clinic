---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import JournalArticleExperience from '../../components/JournalArticleExperience.astro';
import JournalEditorialArticleChrome from '../../components/JournalEditorialArticleChrome.astro';
import { isAcademyBlogPost } from '../../lib/academy';
import { buildBlogPostDownloadMarkdown } from '../../lib/blog-post-download-markdown';
import { buildTocFromMarkdown } from '../../lib/blog-post-toc';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts
    .filter((post) => !isAcademyBlogPost(post))
    .map(post => ({
      params: { slug: post.id },
      props: post,
    }));
}

const post = Astro.props;
const { Content } = await render(post);
const encodedDownloadMarkdown = encodeURIComponent(buildBlogPostDownloadMarkdown(post));
const tocItems = buildTocFromMarkdown(post.body ?? '');
---

<BlogPost {...post.data} body={post.body} tocItems={tocItems} encodedDownloadMarkdown={encodedDownloadMarkdown}>
  <JournalEditorialArticleChrome series={post.data.series} />

  <JournalArticleExperience
    placement="before"
    currentSlug={post.id}
    lead={post.data.lead}
    updated={post.data.updated}
    case_disclosure={post.data.case_disclosure}
  />

  <Content />

  <JournalArticleExperience
    placement="after"
    currentSlug={post.id}
    primary_next={post.data.primary_next}
    related={post.data.related}
    references={post.data.references}
  />
</BlogPost>
